{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "sanjayacloud/laravel-scheduler-monitor",
    "description": "Record the last run, exit code, runtime, and failure of every Laravel scheduled task, with no database tables to migrate.",
    "keywords": [
        "laravel",
        "sanjayacloud",
        "schedule",
        "scheduler",
        "cron",
        "monitoring"
    ],
    "homepage": "https://github.com/sanjayacloud/laravel-scheduler-monitor",
    "license": "MIT",
    "authors": [
        {
            "name": "Sanjaya",
            "email": "sanjayaprasanna20@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^7.4||^8.0",
        "illuminate/console": "^5.4||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0",
        "illuminate/support": "^5.4||^6.0||^7.0||^8.0||^9.0||^10.0||^11.0||^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.9||^3.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0||^9.0||^10.0||^11.0",
        "pestphp/pest": "^2.34||^3.0||^4.0||^5.0",
        "pestphp/pest-plugin-laravel": "^2.3||^3.0||^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "SanjayaCloud\\SchedulerMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SanjayaCloud\\SchedulerMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse"
        ],
        "test:unit": [
            "vendor/bin/pest"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:unit"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SanjayaCloud\\SchedulerMonitor\\SchedulerMonitorServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
